# Browser-safe configuration. Never expose service-role or provider secrets as VITE_*.
VITE_DATA_MODE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Global safety controls. Production provider calls remain disabled until both are changed server-side.
PROVIDER_DRY_RUN=true
EXTERNAL_PROVIDERS_ENABLED=false
ADMIN_EMAILS=owner@example.com
APP_ORIGIN=http://localhost:5173
JOB_RUNNER_SECRET=

# Supabase / Google OAuth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
ASSET_IMPORT_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Discovery and analysis providers
YOUTUBE_API_KEY=
YOUTUBE_WEBSUB_CALLBACK_SECRET=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
PARALLEL_API_KEY=
TAVILY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Provider application ceilings
XAI_MONTHLY_DISCOVERY_BUDGET_USD=3
PARALLEL_MONTHLY_REQUEST_LIMIT=1000
TAVILY_MONTHLY_CREDIT_LIMIT=900
TAVILY_SCHEDULED_CREDIT_LIMIT=800
TAVILY_MANUAL_CREDIT_RESERVE=100
PEXELS_MONTHLY_REQUEST_LIMIT=20000

# Stripe hosted Billing
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# Optional email and Cloudflare backup destination
RESEND_API_KEY=
RESEND_FROM_EMAIL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
BACKUP_ENCRYPTION_KEY=
